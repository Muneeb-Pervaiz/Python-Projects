from cryptography.fernet import Fernet
import os

print("What do you want?")
print("a) Encrypt")
print("b) decrypt")
option = input("Select option a or b: ")

if option == 'a':
    message = input("Write your message here: ")
    key = Fernet.generate_key()
    fernet = Fernet(key)
    encMessage = fernet.encrypt(message.encode())
    print("original string: ", message)
    print("encrypted string: ", encMessage)
    with open("secret_key.txt", "wb") as key_file:
        key_file.write(key)
    with open("encrypted_message.txt", "wb") as enc_file:
        enc_file.write(encMessage)
    print("Key saved to: secret_key.txt")
    print("Encrypted message saved to: encrypted_message.txt")


elif option == 'b':
    key_file_path = input("Enter the path to your key file (e.g., C:/path/to/secret_key.txt): ")
    with open(key_file_path, "rb") as key_file:
        key = key_file.read()
    fernet = Fernet(key)
    enc_file_path = input("Enter the path to your encrypted message file (e.g., C:/path/to/encrypted_message.txt): ")
    with open(enc_file_path, "rb") as enc_file:
        encMessage = enc_file.read()
    decMessage = fernet.decrypt(encMessage).decode()
    print("Decrypted message:", decMessage)
